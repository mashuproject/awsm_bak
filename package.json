{
  "name": "awsm",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "corepack pnpm --filter @awsm/browser-extension build",
    "design:generate": "node apps/design-system/scripts/generate.mjs",
    "design:icons": "node apps/design-system/scripts/generate-icons.mjs",
    "design:check": "designmd lint DESIGN.md && node apps/design-system/scripts/generate.mjs --check && node apps/design-system/scripts/check-token-references.mjs",
    "lint": "corepack pnpm design:check && corepack pnpm --filter @awsm/browser-extension lint && corepack pnpm lint:ui && corepack pnpm typecheck:runtime",
    "test": "corepack pnpm --filter @awsm/browser-extension test && corepack pnpm --filter @awsm/ui test",
    "test:integration": "corepack pnpm --filter @awsm/browser-extension test:integration",
    "test:e2e": "corepack pnpm --filter @awsm/browser-extension test:e2e",
    "test:e2e:chrome": "corepack pnpm --filter @awsm/browser-extension test:e2e:chrome",
    "test:e2e:brave": "corepack pnpm --filter @awsm/browser-extension test:e2e:brave",
    "test:e2e:firefox": "corepack pnpm --filter @awsm/browser-extension test:e2e:firefox",
    "test:e2e:cross-browser": "corepack pnpm --filter @awsm/browser-extension test:e2e:cross-browser",
    "test:e2e:desktop-runtime": "corepack pnpm --filter @awsm/browser-extension test:e2e:desktop-runtime",
    "test:e2e:desktop-runtime:firefox": "corepack pnpm --filter @awsm/browser-extension test:e2e:desktop-runtime:firefox",
    "test:e2e:coordination": "apps/coordination-server/script/run-coordination-e2e.sh",
    "test:e2e:design": "corepack pnpm --filter @awsm/browser-extension test:e2e:design",
    "test:ui": "corepack pnpm --filter @awsm/ui test",
    "test:sync-proof": "apps/coordination-server/script/run-sync-proof.sh",
    "test:runtime": "go -C apps/runtime-go test ./...",
    "test:runtime:smoke": "node apps/runtime-go/script/runtime-smoke.mjs",
    "test:runtime:wails": "AWSM_RUNTIME_WAILS=1 node apps/runtime-go/script/runtime-smoke.mjs",
    "typecheck:runtime": "go -C apps/runtime-go vet ./...",
    "build:runtime:frontend": "corepack pnpm --filter @awsm/runtime-frontend build",
    "build:runtime": "corepack pnpm build:runtime:frontend && go -C apps/runtime-go build ./cmd/awsm",
    "lint:ui": "corepack pnpm --filter @awsm/browser-extension exec biome check ../runtime-go/cmd/awsm/frontend ../../packages/ui",
    "typecheck:runtime:frontend": "corepack pnpm --filter @awsm/runtime-frontend typecheck",
    "typecheck": "corepack pnpm --filter @awsm/browser-extension typecheck && corepack pnpm typecheck:runtime:frontend && corepack pnpm typecheck:runtime",
    "zip": "corepack pnpm --filter @awsm/browser-extension zip",
    "ui:storybook": "corepack pnpm --filter @awsm/ui storybook",
    "ui:storybook:build": "corepack pnpm --filter @awsm/ui storybook:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@google/design.md": "0.3.0",
    "prettier": "3.9.5",
    "shadcn": "4.16.1",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.0"
  }
}
