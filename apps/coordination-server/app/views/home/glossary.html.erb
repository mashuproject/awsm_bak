<% content_for :title, "AWSM Glossary" %>
<% content_for :body_class, "public-site" %>
<%= render "shared/public_header" %>

<main class="site-container glossary-page" data-controller="glossary">
  <header class="glossary-page__header">
    <p class="eyebrow">AWSM Glossary</p>
    <h1>The language of your archive.</h1>
    <p>
      These short entries explain the words used on this site. For the exact technical meanings,
      read the <%= link_to "full architecture glossary", "#{public_product_links[:source]}/blob/main/docs/architecture/glossary.md" %>.
    </p>
  </header>

  <div class="glossary-reference">
    <nav class="glossary-index"
         aria-label="Glossary terms"
         data-turbo="false"
         data-action="pointerover->glossary#preview pointerout->glossary#clearPreview focusin->glossary#preview focusout->glossary#clearPreview">
      <% @glossary_sections.each do |section| %>
        <section class="glossary-index__section" aria-labelledby="<%= "glossary-index-#{section.title.parameterize}" %>">
          <h2 id="<%= "glossary-index-#{section.title.parameterize}" %>"><%= section.title %></h2>
          <% section.terms.each do |term| %>
            <%= link_to term.title, "##{term.anchor}" %>
          <% end %>
        </section>
      <% end %>
    </nav>

    <div class="glossary-list">
      <% @glossary_sections.each do |section| %>
        <section class="glossary-list__section">
          <h2><%= section.title %></h2>
          <dl>
            <% section.terms.each do |term| %>
              <div id="<%= term.anchor %>">
                <dt><%= term.title %></dt>
                <dd><p><%= glossary_summary(term) %></p></dd>
              </div>
            <% end %>
          </dl>
        </section>
      <% end %>
    </div>
  </div>
</main>

<%= render "shared/public_footer" %>
