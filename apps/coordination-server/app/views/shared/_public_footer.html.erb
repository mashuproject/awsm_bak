<footer class="site-footer">
  <div class="site-container">
    <nav class="site-footer__links" aria-label="Footer">
      <%= link_to "Get AWSM", "#{root_path}#install-awsm" %>
      <%= link_to "Chrome guide", public_product_links[:chrome_guide] %>
      <%= link_to "Firefox guide", public_product_links[:firefox_guide] %>
      <%= link_to "Desktop Runtime guide", public_product_links[:desktop_guide] %>
      <%= link_to "Privacy", privacy_path %>
      <%= link_to "Security", security_path %>
      <%= link_to "Glossary", glossary_path %>
      <%= link_to "Compare tools", compare_path %>
      <%= link_to "Source", public_product_links[:source] %>
      <%= link_to "Documentation", public_product_links[:documentation] %>
      <%= link_to "AGPL license", public_product_links[:license] %>
      <%= link_to "Sign in", new_session_path, data: { public_session_target: "footerAccountLink" } %>
    </nav>
    <div class="site-footer__appearance">
      <label for="appearance-mode">Appearance</label>
      <select id="appearance-mode" data-appearance-target="select" data-action="appearance#change">
        <option value="system">System default</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
    </div>
    <p><strong>AWSM</strong> lets you Archive What Should Matter. Keep it yours.</p>
  </div>
</footer>
