<% content_for :title, "Sign in to AWSM" %>

<%= render layout: "shared/account_shell",
           locals: {
             story_heading: "Sign in to coordinate encrypted copies.",
             story_copy: "Your Account password proves who you are to this server. Your Recovery Phrase and Vault keys remain separate and client-held."
           } do %>
  <p class="eyebrow">Account</p>
  <h1>Sign in</h1>
  <p>Use the Account password for this Coordination Server.</p>

  <%= form_with url: session_path, class: "account-form" do |form| %>
    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username, required: true, autocomplete: "username", minlength: 3, maxlength: 32 %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="actions"><%= form.submit "Sign in" %></div>
  <% end %>

  <% if Coordination::Registration.enabled? %>
    <p>Need optional synchronization? <%= link_to "Create an Account", sign_up_path %>.</p>
  <% end %>
  <p><%= link_to "Return to AWSM", root_path %></p>
<% end %>
