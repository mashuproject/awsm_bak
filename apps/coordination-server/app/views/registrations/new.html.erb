<% content_for :title, "Create AWSM Account" %>

<h1>Create your Account</h1>
<p>Your Account identifies you to this Coordination Server. Its password cannot decrypt your Vault.</p>

<%= form_with model: @account, url: sign_up_path do |form| %>
  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
  </div>
  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Confirm password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="actions"><%= form.submit "Create Account" %></div>
<% end %>

<p><%= link_to "Already have an Account? Sign in", new_session_path %></p>
